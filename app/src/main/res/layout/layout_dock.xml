<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/dockRootContainer"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center_horizontal">

    <LinearLayout
        android:id="@+id/popupLauncher"
        android:layout_width="520dp"
        android:layout_height="350dp"
        android:background="@drawable/bg_glass_card"
        android:visibility="gone"
        android:orientation="vertical"
        android:padding="16dp"
        android:layout_marginBottom="12dp">

        <LinearLayout
            android:id="@+id/searchBarContainer"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="@drawable/bg_dock_item_glow"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="14dp">

            <ImageView
                android:id="@+id/ivSearchIconPopup"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_search"
                android:layout_marginEnd="10dp" />

            <EditText
                android:id="@+id/etSearch"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:hint="Поиск (Enter для поиска в сети)..."
                android:textColorHint="#99A6ADC8"
                android:textColor="#FFFFFF"
                android:background="@null"
                android:textSize="14sp"
                android:singleLine="true" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvLauncherHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Удерживайте для закрепления в доке"
            android:textColor="#F34664"
            android:textSize="11sp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="8dp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvApps"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/popupClipboard"
        android:layout_width="440dp"
        android:layout_height="270dp"
        android:background="@drawable/bg_glass_card"
        android:visibility="gone"
        android:orientation="vertical"
        android:padding="16dp"
        android:layout_marginBottom="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="10dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="История буфера Scream (10 последних)"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btnClearClip"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="Очистить"
                android:textColor="#F34664"
                android:background="@null"
                android:textSize="11sp" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvClipboard"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/dockBar"
        android:layout_width="wrap_content"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:paddingHorizontal="10dp"
        android:gravity="center_vertical">

        <FrameLayout
            android:id="@+id/btnSearchLauncher"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_dock_item_glow"
            android:clickable="true"
            android:focusable="true">
            <ImageView
                android:id="@+id/ivDockSearchIcon"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_search" />
        </FrameLayout>

        <View
            android:layout_width="1dp"
            android:layout_height="20dp"
            android:background="#33FFFFFF"
            android:layout_marginHorizontal="6dp" />

        <LinearLayout
            android:id="@+id/dockAppsContainer"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical" />

        <View
            android:layout_width="1dp"
            android:layout_height="20dp"
            android:background="#33FFFFFF"
            android:layout_marginHorizontal="6dp" />

        <FrameLayout
            android:id="@+id/btnClipboardToggle"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_dock_item_glow"
            android:clickable="true"
            android:focusable="true">
            <ImageView
                android:id="@+id/ivDockClipIcon"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_clipboard" />
            <TextView
                android:id="@+id/tvClipBadge"
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:layout_gravity="top|end"
                android:background="#F34664"
                android:textColor="#FFFFFF"
                android:textSize="8sp"
                android:textStyle="bold"
                android:gravity="center"
                android:text="0" />
        </FrameLayout>
    </LinearLayout>

</LinearLayout>
