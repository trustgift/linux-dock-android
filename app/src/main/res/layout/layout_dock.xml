<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/dockRootContainer"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center_horizontal">

    <!-- Всплывающий поисковик и каталог приложений -->
    <LinearLayout
        android:id="@+id/popupLauncher"
        android:layout_width="540dp"
        android:layout_height="360dp"
        android:background="@drawable/bg_glass_card"
        android:visibility="gone"
        android:orientation="vertical"
        android:padding="16dp"
        android:layout_marginBottom="12dp">

        <LinearLayout
            android:id="@+id/searchBarContainer"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:background="@drawable/bg_dock_item_glow"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="14dp">

            <ImageView
                android:id="@+id/ivSearchIconPopup"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_search"
                android:layout_marginEnd="10dp" />

            <EditText
                android:id="@+id/etSearch"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:hint="Поиск приложений (Enter для поиска в сети)..."
                android:textColorHint="#99A6ADC8"
                android:textColor="#FFFFFF"
                android:background="@null"
                android:textSize="14sp"
                android:singleLine="true" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvLauncherHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Удерживайте приложение, чтобы закрепить в Scream Dock"
            android:textColor="#F34664"
            android:textSize="11sp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="8dp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvApps"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />
    </LinearLayout>

    <!-- Всплывающее меню буфера обмена -->
    <LinearLayout
        android:id="@+id/popupClipboard"
        android:layout_width="460dp"
        android:layout_height="280dp"
        android:background="@drawable/bg_glass_card"
        android:visibility="gone"
        android:orientation="vertical"
        android:padding="16dp"
        android:layout_marginBottom="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="История буфера Scream (10 последних)"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btnClearClip"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="Очистить"
                android:textColor="#F34664"
                android:background="@null"
                android:textSize="11sp" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvClipboard"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </LinearLayout>

    <!-- Нижняя полоса Scream Dock -->
    <LinearLayout
        android:id="@+id/dockBar"
        android:layout_width="wrap_content"
        android:layout_height="58dp"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:gravity="center_vertical">

        <!-- Кнопка поиска -->
        <FrameLayout
            android:id="@+id/btnSearchLauncher"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/bg_dock_item_glow"
            android:clickable="true"
            android:focusable="true">
            <ImageView
                android:id="@+id/ivDockSearchIcon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_search" />
        </FrameLayout>

        <View
            android:id="@+id/dockDivider1"
            android:layout_width="1dp"
            android:layout_height="22dp"
            android:background="#44FFFFFF"
            android:layout_marginHorizontal="8dp" />

        <!-- Контейнер закрепленных приложений -->
        <LinearLayout
            android:id="@+id/dockAppsContainer"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical" />

        <View
            android:id="@+id/dockDivider2"
            android:layout_width="1dp"
            android:layout_height="22dp"
            android:background="#44FFFFFF"
            android:layout_marginHorizontal="8dp" />

        <!-- Кнопка буфера -->
        <FrameLayout
            android:id="@+id/btnClipboardToggle"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/bg_dock_item_glow"
            android:clickable="true"
            android:focusable="true">
            <ImageView
                android:id="@+id/ivDockClipIcon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_clipboard" />
            <TextView
                android:id="@+id/tvClipBadge"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_gravity="top|end"
                android:background="#F34664"
                android:textColor="#FFFFFF"
                android:textSize="9sp"
                android:textStyle="bold"
                android:gravity="center"
                android:text="0" />
        </FrameLayout>
    </LinearLayout>

</LinearLayout>
