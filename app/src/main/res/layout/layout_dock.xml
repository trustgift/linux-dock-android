<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/dockRootContainer"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center_horizontal">

    <!-- Всплывающее меню Пуск / Поиск -->
    <LinearLayout
        android:id="@+id/popupLauncher"
        android:layout_width="520dp"
        android:layout_height="380dp"
        android:background="@drawable/bg_dock"
        android:visibility="gone"
        android:orientation="vertical"
        android:padding="16dp"
        android:layout_marginBottom="12dp">

        <EditText
            android:id="@+id/etSearch"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:hint="🔍 Введите для поиска приложений..."
            android:textColorHint="#6C7086"
            android:textColor="#CDD6F4"
            android:background="#1E1E2E"
            android:paddingHorizontal="16dp"
            android:textSize="14sp"
            android:singleLine="true" />

        <TextView
            android:id="@+id/tvSectionTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Приложения"
            android:textColor="#A6ADC8"
            android:textSize="12sp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="8dp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvApps"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />
    </LinearLayout>

    <!-- Всплывающий буфер обмена -->
    <LinearLayout
        android:id="@+id/popupClipboard"
        android:layout_width="440dp"
        android:layout_height="280dp"
        android:background="@drawable/bg_dock"
        android:visibility="gone"
        android:orientation="vertical"
        android:padding="16dp"
        android:layout_marginBottom="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📋 История буфера обмена (последние 10)"
            android:textColor="#CDD6F4"
            android:textStyle="bold"
            android:textSize="14sp"
            android:layout_marginBottom="10dp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvClipboard"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </LinearLayout>

    <!-- Сама панель дока -->
    <LinearLayout
        android:id="@+id/dockBar"
        android:layout_width="wrap_content"
        android:layout_height="56dp"
        android:background="@drawable/bg_dock"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:gravity="center_vertical">

        <Button
            android:id="@+id/btnApps"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="⊞ Пуск"
            android:textStyle="bold"
            android:textColor="#11111B"
            android:backgroundTint="#89B4FA"
            android:textSize="13sp"
            android:layout_marginEnd="8dp" />

        <!-- Контейнер для иконок недавних приложений -->
        <LinearLayout
            android:id="@+id/recentIconsContainer"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/btnClipboard"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="📋 Буфер"
            android:textColor="#CDD6F4"
            android:backgroundTint="#313244"
            android:textSize="12sp" />
    </LinearLayout>

</LinearLayout>
