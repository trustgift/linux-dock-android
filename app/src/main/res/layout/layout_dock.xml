<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/dockRootContainer"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center_horizontal">

    <!-- Всплывающий Spotlight лаунчер -->
    <LinearLayout
        android:id="@+id/popupLauncher"
        android:layout_width="520dp"
        android:layout_height="350dp"
        android:background="@drawable/bg_glass_card"
        android:visibility="gone"
        android:orientation="vertical"
        android:padding="16dp"
        android:layout_marginBottom="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="@drawable/bg_dock_item_glow"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="14dp">

            <ImageView
                android:id="@+id/ivSearchIconPopup"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_search"
                android:layout_marginEnd="10dp" />

            <EditText
                android:id="@+id/etSearch"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:hint="Поиск программ (Enter для браузера)..."
                android:textColorHint="#99BAC2DE"
                android:textColor="#FFFFFF"
                android:background="@null"
                android:textSize="14sp"
                android:singleLine="true" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvLauncherHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Удерживайте иконку для закрепления в доке Scream"
            android:textColor="#BAC2DE"
            android:textSize="11sp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="8dp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvApps"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />
    </LinearLayout>

    <!-- Нижняя полоса Liquid Glass дока -->
    <LinearLayout
        android:id="@+id/dockBar"
        android:layout_width="wrap_content"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:paddingHorizontal="10dp"
        android:gravity="center_vertical">

        <!-- Кнопка Spotlight -->
        <FrameLayout
            android:id="@+id/btnSearchLauncher"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_dock_item_glow"
            android:clickable="true"
            android:focusable="true">
            <ImageView
                android:id="@+id/ivDockSearchIcon"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_search" />
        </FrameLayout>

        <View
            android:id="@+id/dockDivider"
            android:layout_width="1dp"
            android:layout_height="22dp"
            android:background="#44FFFFFF"
            android:layout_marginHorizontal="8dp" />

        <!-- Закрепленные программы -->
        <LinearLayout
            android:id="@+id/dockAppsContainer"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical" />

    </LinearLayout>

</LinearLayout>
