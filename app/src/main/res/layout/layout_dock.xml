<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/dockRootContainer"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center_horizontal">

    <!-- Всплывающее меню приложений со строкой поиска -->
    <LinearLayout
        android:id="@+id/popupLauncher"
        android:layout_width="560dp"
        android:layout_height="360dp"
        android:background="@drawable/bg_card_translucent"
        android:visibility="gone"
        android:orientation="vertical"
        android:padding="16dp"
        android:layout_marginBottom="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:background="#28283D"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="14dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_search"
                android:layout_marginEnd="10dp" />

            <EditText
                android:id="@+id/etSearch"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:hint="Поиск или Enter для интернета..."
                android:textColorHint="#6C7086"
                android:textColor="#CDD6F4"
                android:background="@null"
                android:textSize="14sp"
                android:singleLine="true" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Удерживайте иконку для закрепления в доке"
            android:textColor="#89B4FA"
            android:textSize="11sp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="8dp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvApps"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />
    </LinearLayout>

    <!-- Всплывающий буфер обмена -->
    <LinearLayout
        android:id="@+id/popupClipboard"
        android:layout_width="450dp"
        android:layout_height="280dp"
        android:background="@drawable/bg_card_translucent"
        android:visibility="gone"
        android:orientation="vertical"
        android:padding="16dp"
        android:layout_marginBottom="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Буфер обмена (10 последних)"
                android:textColor="#CDD6F4"
                android:textStyle="bold"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btnClearClip"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="Очистить"
                android:textColor="#F38BA8"
                android:background="@null"
                android:textSize="11sp" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvClipboard"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </LinearLayout>

    <!-- Сама панель дока -->
    <LinearLayout
        android:id="@+id/dockBar"
        android:layout_width="wrap_content"
        android:layout_height="58dp"
        android:background="@drawable/bg_dock_glass"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:gravity="center_vertical">

        <!-- Кнопка поиска -->
        <FrameLayout
            android:id="@+id/btnSearchLauncher"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/bg_dock_item"
            android:clickable="true"
            android:focusable="true">
            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_search" />
        </FrameLayout>

        <View
            android:layout_width="1dp"
            android:layout_height="24dp"
            android:background="#44FFFFFF"
            android:layout_marginHorizontal="8dp" />

        <!-- Иконки закрепленных приложений -->
        <LinearLayout
            android:id="@+id/dockAppsContainer"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical" />

        <View
            android:layout_width="1dp"
            android:layout_height="24dp"
            android:background="#44FFFFFF"
            android:layout_marginHorizontal="8dp" />

        <!-- Кнопка буфера -->
        <FrameLayout
            android:id="@+id/btnClipboardToggle"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/bg_dock_item"
            android:clickable="true"
            android:focusable="true">
            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_clipboard" />
            <TextView
                android:id="@+id/tvClipBadge"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_gravity="top|end"
                android:background="#F38BA8"
                android:textColor="#11111B"
                android:textSize="9sp"
                android:textStyle="bold"
                android:gravity="center"
                android:text="0" />
        </FrameLayout>
    </LinearLayout>

</LinearLayout>
