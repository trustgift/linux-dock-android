<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#11111B"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center_horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Linux Dock Settings"
            android:textColor="#CDD6F4"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Интерфейс и управление плавающим доком"
            android:textColor="#A6ADC8"
            android:textSize="14sp"
            android:layout_marginBottom="24dp" />

        <!-- Главный тумблер включения/выключения службы -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:background="@drawable/bg_card_translucent"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="20dp"
            android:layout_marginBottom="24dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Активация дока"
                android:textColor="#CDD6F4"
                android:textSize="16sp"
                android:textStyle="bold" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switchDock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <!-- Блок выбора стиля оформления -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Стиль оформления:"
            android:textColor="#CDD6F4"
            android:textSize="15sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp" />

        <RadioGroup
            android:id="@+id/rgThemes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="24dp">

            <RadioButton
                android:id="@+id/rbGlass"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Frosted Glass (Светлое матовое стекло)"
                android:textColor="#BAC2DE"
                android:checked="true" />

            <RadioButton
                android:id="@+id/rbObsidian"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cyber Obsidian (Глубокий тёмный с акцентом)"
                android:textColor="#BAC2DE" />

            <RadioButton
                android:id="@+id/rbMinimal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Minimal Pure Glass (Ультрапрозрачный)"
                android:textColor="#BAC2DE" />
        </RadioGroup>

        <!-- Live Preview прямо в приложении -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Предпросмотр на рабочем столе:"
            android:textColor="#A6ADC8"
            android:textSize="13sp"
            android:layout_marginBottom="10dp" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="140dp"
            android:background="#181825"
            android:padding="16dp">

            <LinearLayout
                android:id="@+id/previewDockBar"
                android:layout_width="wrap_content"
                android:layout_height="56dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_dock_glass"
                android:orientation="horizontal"
                android:paddingHorizontal="14dp"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_search"
                    android:layout_marginEnd="12dp" />

                <View
                    android:layout_width="1dp"
                    android:layout_height="24dp"
                    android:background="#55FFFFFF"
                    android:layout_marginEnd="12dp" />

                <View
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="@drawable/bg_dock_item"
                    android:layout_marginEnd="8dp" />

                <View
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="@drawable/bg_dock_item"
                    android:layout_marginEnd="8dp" />

                <View
                    android:layout_width="1dp"
                    android:layout_height="24dp"
                    android:background="#55FFFFFF"
                    android:layout_marginEnd="12dp" />

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_clipboard" />
            </LinearLayout>
        </FrameLayout>

    </LinearLayout>
</ScrollView>
