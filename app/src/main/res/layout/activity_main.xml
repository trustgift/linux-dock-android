<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#090A10"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:gravity="center_horizontal">

        <ImageView
            android:layout_width="68dp"
            android:layout_height="68dp"
            android:src="@drawable/ic_app_scream"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SCREAM DOCK"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ultra Liquid Glass Workspace"
            android:textColor="#F34664"
            android:textSize="12sp"
            android:layout_marginBottom="20dp" />

        <!-- 1. Главный тумблер -->
        <LinearLayout
            android:id="@+id/cardService"
            android:layout_width="match_parent"
            android:layout_height="68dp"
            android:background="@drawable/bg_glass_card"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="18dp"
            android:layout_marginBottom="14dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Островок Scream"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Срабатывание по центру нижней кромки"
                    android:textColor="#BAC2DE"
                    android:textSize="11sp" />
            </LinearLayout>

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switchDock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <!-- 2. Разработчик -->
        <LinearLayout
            android:id="@+id/cardDev"
            android:layout_width="match_parent"
            android:layout_height="62dp"
            android:background="@drawable/bg_glass_card"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="18dp"
            android:layout_marginBottom="14dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Разработчик"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnTelegram"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:text="@screamsoon ↗"
                android:textColor="#FFFFFF"
                android:backgroundTint="#F34664"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- 3. Служба доступности -->
        <LinearLayout
            android:id="@+id/cardAccessibility"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_glass_card"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginBottom="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="СЛУЖБА ДОСТУПНОСТИ (БУФЕР И КЛАВИАТУРА)"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="12sp"
                android:layout_marginBottom="4dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Требуется для работы буфера обмена и горячих клавиш"
                android:textColor="#BAC2DE"
                android:textSize="11sp"
                android:layout_marginBottom="10dp" />

            <Button
                android:id="@+id/btnAccessibility"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:text="Включить в спец. возможностях"
                android:textColor="#FFFFFF"
                android:backgroundTint="#2E3044"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- 4. Настройка стекла и круглых акцентов -->
        <LinearLayout
            android:id="@+id/cardColor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_glass_card"
            android:orientation="vertical"
            android:padding="18dp"
            android:layout_marginBottom="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="СТИЛИЗАЦИЯ И ЖИДКОЕ СТЕКЛО"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="13sp"
                android:layout_marginBottom="14dp" />

            <!-- Слайдер прозрачности -->
            <TextView
                android:id="@+id/tvOpacityLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Прозрачность стекла: 75%"
                android:textColor="#CDD6F4"
                android:textSize="12sp"
                android:layout_marginBottom="4dp" />

            <SeekBar
                android:id="@+id/seekOpacity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="100"
                android:progress="75"
                android:layout_marginBottom="14dp" />

            <!-- Слайдер контура -->
            <TextView
                android:id="@+id/tvBorderLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Толщина контура: 1.5 dp (0 = чистое стекло)"
                android:textColor="#CDD6F4"
                android:textSize="12sp"
                android:layout_marginBottom="4dp" />

            <SeekBar
                android:id="@+id/seekBorder"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="4"
                android:progress="2"
                android:layout_marginBottom="16dp" />

            <!-- Кругляшки быстрых цветов -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Быстрые акцентные сферы (кругляшки):"
                android:textColor="#CDD6F4"
                android:textSize="12sp"
                android:layout_marginBottom="12dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginBottom="16dp">

                <FrameLayout
                    android:id="@+id/circleCrimson"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginHorizontal="6dp"
                    android:background="@drawable/bg_circle_ring">
                    <View
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_gravity="center"
                        android:background="@drawable/bg_circle_ring"
                        android:backgroundTint="#F34664" />
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/circlePurple"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginHorizontal="6dp"
                    android:background="@drawable/bg_circle_ring">
                    <View
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_gravity="center"
                        android:background="@drawable/bg_circle_ring"
                        android:backgroundTint="#CBA6F7" />
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/circleCyan"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginHorizontal="6dp"
                    android:background="@drawable/bg_circle_ring">
                    <View
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_gravity="center"
                        android:background="@drawable/bg_circle_ring"
                        android:backgroundTint="#89B4FA" />
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/circleMint"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginHorizontal="6dp"
                    android:background="@drawable/bg_circle_ring">
                    <View
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_gravity="center"
                        android:background="@drawable/bg_circle_ring"
                        android:backgroundTint="#A6E3A1" />
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/circleWhite"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginHorizontal="6dp"
                    android:background="@drawable/bg_circle_ring">
                    <View
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_gravity="center"
                        android:background="@drawable/bg_circle_ring"
                        android:backgroundTint="#FFFFFF" />
                </FrameLayout>
            </LinearLayout>

            <Button
                android:id="@+id/btnOpenFullPalette"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:text="🎨 Палитра спектра (кругляшки и градиент)"
                android:textColor="#FFFFFF"
                android:backgroundTint="#242636"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- 5. Живой предпросмотр дока -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_glass_card"
            android:orientation="vertical"
            android:padding="18dp"
            android:layout_marginBottom="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ПРЕДПРОСМОТР ЖИДКОГО СТЕКЛА"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="13sp"
                android:layout_marginBottom="12dp" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="90dp"
                android:background="#12131F">

                <LinearLayout
                    android:id="@+id/previewDockBar"
                    android:layout_width="wrap_content"
                    android:layout_height="52dp"
                    android:layout_gravity="center"
                    android:orientation="horizontal"
                    android:paddingHorizontal="14dp"
                    android:gravity="center_vertical">

                    <ImageView
                        android:id="@+id/ivPreviewSearch"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_search"
                        android:layout_marginEnd="8dp" />

                    <View
                        android:layout_width="1dp"
                        android:layout_height="18dp"
                        android:background="#44FFFFFF"
                        android:layout_marginEnd="8dp" />

                    <View
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:background="@drawable/bg_dock_item_glow"
                        android:layout_marginEnd="6dp" />

                    <View
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:background="@drawable/bg_dock_item_glow"
                        android:layout_marginEnd="6dp" />

                    <View
                        android:layout_width="1dp"
                        android:layout_height="18dp"
                        android:background="#44FFFFFF"
                        android:layout_marginEnd="8dp" />

                    <ImageView
                        android:id="@+id/ivPreviewClip"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_clipboard" />
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>

        <Button
            android:id="@+id/btnApply"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="СОХРАНИТЬ И АКТИВИРОВАТЬ"
            android:textColor="#FFFFFF"
            android:backgroundTint="#F34664"
            android:textStyle="bold"
            android:textSize="14sp" />

    </LinearLayout>
</ScrollView>
