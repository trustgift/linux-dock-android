<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0B10"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:gravity="center_horizontal">

        <!-- Шапка -->
        <ImageView
            android:layout_width="68dp"
            android:layout_height="68dp"
            android:src="@drawable/ic_app_scream"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SCREAM DOCK"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Liquid Glass Workspace"
            android:textColor="#F34664"
            android:textSize="12sp"
            android:layout_marginBottom="20dp" />

        <!-- 1. Главный тумблер -->
        <LinearLayout
            android:id="@+id/cardService"
            android:layout_width="match_parent"
            android:layout_height="66dp"
            android:background="@drawable/bg_glass_card"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="18dp"
            android:layout_marginBottom="14dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Островок Scream"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Срабатывание по центру нижней кромки"
                    android:textColor="#A6ADC8"
                    android:textSize="11sp" />
            </LinearLayout>

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switchDock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <!-- 2. Разработчик -->
        <LinearLayout
            android:id="@+id/cardDev"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:background="@drawable/bg_glass_card"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="18dp"
            android:layout_marginBottom="14dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Разработчик"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnTelegram"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:text="@screamsoon ↗"
                android:textColor="#FFFFFF"
                android:backgroundTint="#F34664"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- 3. Настройка цвета и стекла -->
        <LinearLayout
            android:id="@+id/cardColor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_glass_card"
            android:orientation="vertical"
            android:padding="18dp"
            android:layout_marginBottom="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="СТИЛИЗАЦИЯ И ЖИДКОЕ СТЕКЛО"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="13sp"
                android:layout_marginBottom="14dp" />

            <!-- Прозрачность -->
            <TextView
                android:id="@+id/tvOpacityLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Прозрачность стекла: 75%"
                android:textColor="#CDD6F4"
                android:textSize="12sp"
                android:layout_marginBottom="4dp" />

            <SeekBar
                android:id="@+id/seekOpacity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="100"
                android:progress="75"
                android:layout_marginBottom="14dp" />

            <!-- Толщина контура (можно в ноль) -->
            <TextView
                android:id="@+id/tvBorderLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Толщина контура: 1.5 dp (0 = без контура)"
                android:textColor="#CDD6F4"
                android:textSize="12sp"
                android:layout_marginBottom="4dp" />

            <SeekBar
                android:id="@+id/seekBorder"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="4"
                android:progress="2"
                android:layout_marginBottom="16dp" />

            <!-- Кругляшки быстрых акцентов -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Быстрые акцентные цвета (кругляшки):"
                android:textColor="#CDD6F4"
                android:textSize="12sp"
                android:layout_marginBottom="10dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginBottom="14dp">

                <FrameLayout
                    android:id="@+id/circleCrimson"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_margin="6dp"
                    android:background="@drawable/bg_dock_item_glow">
                    <View
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:layout_gravity="center"
                        android:background="#F34664" />
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/circlePurple"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_margin="6dp"
                    android:background="@drawable/bg_dock_item_glow">
                    <View
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:layout_gravity="center"
                        android:background="#CBA6F7" />
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/circleCyan"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_margin="6dp"
                    android:background="@drawable/bg_dock_item_glow">
                    <View
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:layout_gravity="center"
                        android:background="#89B4FA" />
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/circleMint"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_margin="6dp"
                    android:background="@drawable/bg_dock_item_glow">
                    <View
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:layout_gravity="center"
                        android:background="#A6E3A1" />
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/circleWhite"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_margin="6dp"
                    android:background="@drawable/bg_dock_item_glow">
                    <View
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:layout_gravity="center"
                        android:background="#FFFFFF" />
                </FrameLayout>
            </LinearLayout>

            <!-- Кнопка вызова полноразмерной палитры -->
            <Button
                android:id="@+id/btnOpenFullPalette"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:text="🎨 Открыть полную палитру спектра"
                android:textColor="#FFFFFF"
                android:backgroundTint="#242636"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- 4. Горячие клавиши -->
        <LinearLayout
            android:id="@+id/cardHotkeys"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_glass_card"
            android:orientation="vertical"
            android:padding="18dp"
            android:layout_marginBottom="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ГОРЯЧИЕ КЛАВИШИ БУФЕРА ОБМЕНА"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="13sp"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Нажмите комбинацию при активном оверлее:"
                android:textColor="#A6ADC8"
                android:textSize="11sp"
                android:layout_marginBottom="10dp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="54dp"
                    android:layout_height="38dp"
                    android:background="@drawable/bg_dock_item_glow"
                    android:text="Ctrl"
                    android:textColor="#FFFFFF"
                    android:gravity="center"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=" + "
                    android:textColor="#FFFFFF"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="54dp"
                    android:layout_height="38dp"
                    android:background="@drawable/bg_dock_item_glow"
                    android:text="Alt"
                    android:textColor="#FFFFFF"
                    android:gravity="center"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=" + "
                    android:textColor="#FFFFFF"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="54dp"
                    android:layout_height="38dp"
                    android:background="@drawable/bg_dock_item_glow"
                    android:text="V"
                    android:textColor="#FFFFFF"
                    android:gravity="center"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- 5. Живой предпросмотр -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_glass_card"
            android:orientation="vertical"
            android:padding="18dp"
            android:layout_marginBottom="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ПРЕДПРОСМОТР ДОКА"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="13sp"
                android:layout_marginBottom="12dp" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="84dp"
                android:background="#12131D">

                <LinearLayout
                    android:id="@+id/previewDockBar"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_gravity="center"
                    android:orientation="horizontal"
                    android:paddingHorizontal="14dp"
                    android:gravity="center_vertical">

                    <ImageView
                        android:id="@+id/ivPreviewSearch"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_search"
                        android:layout_marginEnd="8dp" />

                    <View
                        android:layout_width="1dp"
                        android:layout_height="18dp"
                        android:background="#44FFFFFF"
                        android:layout_marginEnd="8dp" />

                    <View
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:background="@drawable/bg_dock_item_glow"
                        android:layout_marginEnd="6dp" />

                    <View
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:background="@drawable/bg_dock_item_glow"
                        android:layout_marginEnd="6dp" />

                    <View
                        android:layout_width="1dp"
                        android:layout_height="18dp"
                        android:background="#44FFFFFF"
                        android:layout_marginEnd="8dp" />

                    <ImageView
                        android:id="@+id/ivPreviewClip"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_clipboard" />
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>

        <!-- Кнопка применить -->
        <Button
            android:id="@+id/btnApply"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="ПРИМЕНИТЬ НАСТРОЙКИ"
            android:textColor="#FFFFFF"
            android:backgroundTint="#F34664"
            android:textStyle="bold"
            android:textSize="14sp" />

    </LinearLayout>
</ScrollView>
