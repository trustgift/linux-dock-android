<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#090A10"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="22dp"
        android:gravity="center_horizontal">

        <ImageView
            android:layout_width="70dp"
            android:layout_height="70dp"
            android:src="@drawable/ic_app_scream"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SCREAM DOCK"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Liquid Glass Workspace"
            android:textColor="#F34664"
            android:textSize="12sp"
            android:layout_marginBottom="22dp" />

        <!-- 1. Карточка статуса -->
        <LinearLayout
            android:id="@+id/cardService"
            android:layout_width="match_parent"
            android:layout_height="68dp"
            android:background="@drawable/bg_glass_card"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="18dp"
            android:layout_marginBottom="14dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Островок Scream"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Срабатывание по центру нижней кромки"
                    android:textColor="#BAC2DE"
                    android:textSize="11sp" />
            </LinearLayout>

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switchDock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <!-- 2. Разработчик -->
        <LinearLayout
            android:id="@+id/cardDev"
            android:layout_width="match_parent"
            android:layout_height="62dp"
            android:background="@drawable/bg_glass_card"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="18dp"
            android:layout_marginBottom="14dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Разработчик"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnTelegram"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:text="@screamsoon ↗"
                android:textColor="#FFFFFF"
                android:backgroundTint="#F34664"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- 3. Стилизация и смешивание цветов -->
        <LinearLayout
            android:id="@+id/cardColor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_glass_card"
            android:orientation="vertical"
            android:padding="18dp"
            android:layout_marginBottom="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="СТИЛИЗАЦИЯ И СМЕШИВАНИЕ ЦВЕТОВ"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="13sp"
                android:layout_marginBottom="14dp" />

            <!-- Режим чистого жидкого стекла -->
            <Button
                android:id="@+id/btnPureGlass"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:text="✨ Включить режим «Чистое жидкое стекло»"
                android:textColor="#FFFFFF"
                android:backgroundTint="#2E3148"
                android:textSize="12sp"
                android:layout_marginBottom="14dp" />

            <!-- Слайдер прозрачности -->
            <TextView
                android:id="@+id/tvOpacityLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Прозрачность стекла: 75%"
                android:textColor="#CDD6F4"
                android:textSize="12sp"
                android:layout_marginBottom="4dp" />

            <SeekBar
                android:id="@+id/seekOpacity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="100"
                android:progress="75"
                android:layout_marginBottom="14dp" />

            <!-- Слайдер контура -->
            <TextView
                android:id="@+id/tvBorderLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Контур стекла: 1.5 dp (0 = без рамок)"
                android:textColor="#CDD6F4"
                android:textSize="12sp"
                android:layout_marginBottom="4dp" />

            <SeekBar
                android:id="@+id/seekBorder"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="4"
                android:progress="2"
                android:layout_marginBottom="16dp" />

            <!-- Смешивание градиента: Выбор Цвета 1 и Цвета 2 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Смешивание градиента дока (Цвет 1 и Цвет 2):"
                android:textColor="#CDD6F4"
                android:textSize="12sp"
                android:layout_marginBottom="10dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginBottom="14dp">

                <!-- Цвет 1 -->
                <LinearLayout
                    android:id="@+id/boxColor1"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_dock_item_glow"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:layout_marginEnd="6dp">
                    <View
                        android:id="@+id/dotColor1"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:background="@drawable/bg_circle_ring"
                        android:backgroundTint="#F34664"
                        android:layout_marginEnd="8dp" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Цвет 1"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- Цвет 2 -->
                <LinearLayout
                    android:id="@+id/boxColor2"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_dock_item_glow"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:layout_marginStart="6dp">
                    <View
                        android:id="@+id/dotColor2"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:background="@drawable/bg_circle_ring"
                        android:backgroundTint="#89B4FA"
                        android:layout_marginEnd="8dp" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Цвет 2"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp" />
                </LinearLayout>

            </LinearLayout>

            <!-- Кругляшки быстрых пресетов -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Готовые сферы неонового градиента:"
                android:textColor="#CDD6F4"
                android:textSize="12sp"
                android:layout_marginBottom="10dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginBottom="6dp">

                <!-- Пресет Crimson Cyber -->
                <FrameLayout
                    android:id="@+id/presetCrimsonCyber"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginHorizontal="6dp"
                    android:background="@drawable/bg_circle_ring">
                    <View
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_gravity="center"
                        android:background="@drawable/bg_circle_ring"
                        android:backgroundTint="#F34664" />
                </FrameLayout>

                <!-- Пресет Cyber Purple -->
                <FrameLayout
                    android:id="@+id/presetPurpleCyan"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginHorizontal="6dp"
                    android:background="@drawable/bg_circle_ring">
                    <View
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_gravity="center"
                        android:background="@drawable/bg_circle_ring"
                        android:backgroundTint="#CBA6F7" />
                </FrameLayout>

                <!-- Пресет Mint Teal -->
                <FrameLayout
                    android:id="@+id/presetMintTeal"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginHorizontal="6dp"
                    android:background="@drawable/bg_circle_ring">
                    <View
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_gravity="center"
                        android:background="@drawable/bg_circle_ring"
                        android:backgroundTint="#A6E3A1" />
                </FrameLayout>

                <!-- Пресет Sunset Fire -->
                <FrameLayout
                    android:id="@+id/presetSunset"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginHorizontal="6dp"
                    android:background="@drawable/bg_circle_ring">
                    <View
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_gravity="center"
                        android:background="@drawable/bg_circle_ring"
                        android:backgroundTint="#FFAA00" />
                </FrameLayout>
            </LinearLayout>

        </LinearLayout>

        <!-- 4. Живой предпросмотр дока -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_glass_card"
            android:orientation="vertical"
            android:padding="18dp"
            android:layout_marginBottom="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ПРЕДПРОСМОТР ЖИДКОГО СТЕКЛА"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="13sp"
                android:layout_marginBottom="12dp" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="90dp"
                android:background="#12131F">

                <LinearLayout
                    android:id="@+id/previewDockBar"
                    android:layout_width="wrap_content"
                    android:layout_height="52dp"
                    android:layout_gravity="center"
                    android:orientation="horizontal"
                    android:paddingHorizontal="14dp"
                    android:gravity="center_vertical">

                    <ImageView
                        android:id="@+id/ivPreviewSearch"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_search"
                        android:layout_marginEnd="8dp" />

                    <View
                        android:layout_width="1dp"
                        android:layout_height="18dp"
                        android:background="#44FFFFFF"
                        android:layout_marginEnd="8dp" />

                    <View
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:background="@drawable/bg_dock_item_glow"
                        android:layout_marginEnd="6dp" />

                    <View
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:background="@drawable/bg_dock_item_glow"
                        android:layout_marginEnd="6dp" />

                    <View
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:background="@drawable/bg_dock_item_glow" />
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>

        <Button
            android:id="@+id/btnApply"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="СОХРАНИТЬ И АКТИВИРОВАТЬ"
            android:textColor="#FFFFFF"
            android:backgroundTint="#F34664"
            android:textStyle="bold"
            android:textSize="14sp" />

    </LinearLayout>
</ScrollView>
